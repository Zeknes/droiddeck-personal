#!/usr/bin/env python3
"""Plasma Shell"""
_IMPORT_LOCK = __import__('threading').RLock()
import os
import subprocess
import sys

SHELL = '/usr/bin/plasmashell'
PLUGIN = 'org.kde.plasma.mobileshell'
SHELL_OPTIONS = ['-p', '--shell-plugin', '--feedback', '-h', '--help', '--help-all', '-v', '--version',
                 '--author', '--license', '-n', '--no-respawn']
# Every command line argument, so the shell's own options are the only ones it accepts.
ALLOWED = SHELL_OPTIONS + [PLUGIN]
# Shells that must not respawn after a crash, so a dying renderer is visible instead of being restarted.
NO_RESPAWN = ['-n', '--no-respawn']


def gpu_path_crashes():
    """Adreno 840 aborted the Mobile shell's scene graph both on Zink (double free) and under QPainter, so on
    that GPU the shell draws through the OpenGL RHI's software device: an RHI renderer, not the software
    scene graph backend that leaves the drawer's grid and the quick settings labels unpainted."""
    name = os.environ.get('DROIDDECK_GPU_NAME', '')
    return 'Adreno' in name and '840' in name


def session():
    """The environment the shell was started with. Anything this process inherited from the desktop
    session is kept, it is only the renderer that the caller decides."""
    return dict(os.environ)


def qt_settings():
    return os.path.join(os.environ.get('HOME', '/root'), '.config', 'QtProject.conf')


def mobile_shell(argv):
    """True for the Mobile shell's own start: KDE clears the session's command line, so plasma_session
    starts this wrapper with no arguments at all, and the other shells name their plugin."""
    if not argv:
        return True
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument in ('-p', '--shell-plugin'):
            return index + 1 < len(argv) and argv[index + 1] == PLUGIN
        if argument not in SHELL_OPTIONS:
            return False
        index += 1
    return False


def main():
    argv = sys.argv[1:]
    if not mobile_shell(argv):
        return subprocess.call([SHELL, *argv], env=dict(session()))
    rest = [a for a in argv if a not in NO_RESPAWN]
    for option in ('-p', '--shell-plugin'):
        if option in rest:
            rest[rest.index(option) + 1] = PLUGIN
    command = [SHELL, *[a for a in argv if a in NO_RESPAWN], *rest]
    # Only this process's own plugin-less start names the shell: plasmashell's default with no argument is
    # another shell, so that start is given the plugin explicitly.
    if not any(a in ('-p', '--shell-plugin') for a in argv):
        command += ['-p', PLUGIN]
    env = session()
    # The desktop session hands every Qt program its GPU driver; the shell keeps that and chooses only
    # its renderer. A software scene graph is what left ttys (the clock's date) as its only painted text.
    for key in ('QT_QUICK_BACKEND', 'LIBGL_ALWAYS_SOFTWARE', 'GALLIUM_DRIVER', 'MESA_LOADER_DRIVER_OVERRIDE',
                'QT_ENABLE_GLYPH_CACHE_WORKAROUND', 'DROIDDECK_GLTHREAD'):
        env.pop(key, None)
    env.update(QT_QUICK_BACKEND='rhi', QSG_RHI_BACKEND='opengl')
    # The Adreno 840 crash reports so far are one report per shell start, which the basic loop gives.
    env['QT_OPENGL'] = 'software'
    env['QSG_RENDER_LOOP'] = 'basic'
    shell_cpus = env.pop('DROIDDECK_SHELL_CPUS', '')
    if gpu_path_crashes():
        if shell_cpus:
            try:
                cpus = set()
                for part in shell_cpus.split(','):
                    first, _, last = part.partition('-')
                    cpus.update(range(int(first), int(last or first) + 1))
                os.sched_setaffinity(0, cpus)
            except (ValueError, OSError):
                pass
        # QtProject.conf outranks QT_QUICK_BACKEND, and on Adreno 840 it still holds the software scene
        # graph an earlier release wrote there; drop that key so the RHI backend is the one in use.
        conf = qt_settings()
        try:
            with open(conf, encoding='utf-8') as handle:
                lines = handle.read().splitlines()
        except OSError:
            lines = []
        kept = [line for line in lines if not line.strip().startswith('SceneGraphBackend=')]
        if kept != lines:
            with open(conf, 'w', encoding='utf-8') as handle:
                handle.write(''.join(line + '\n' for line in kept))
            os.chmod(conf, 0o644)
    return subprocess.call(command, env=env)


if __name__ == '__main__':
    raise SystemExit(main())
