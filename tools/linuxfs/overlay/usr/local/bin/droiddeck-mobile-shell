#!/usr/bin/env python3
import os
from pathlib import Path
import subprocess
import sys


def main():
    command = ['/usr/bin/plasmashell', *sys.argv[1:]]
    env = dict(os.environ)
    env.update(QT_QUICK_BACKEND='software', LIBGL_ALWAYS_SOFTWARE='1', GALLIUM_DRIVER='llvmpipe')
    env.pop('MESA_LOADER_DRIVER_OVERRIDE', None)
    return subprocess.call(command, env=env)


if __name__ == '__main__':
    raise SystemExit(main())
