#!/usr/bin/env python3
"""The Mobile shell draws through llvmpipe: the shell's Zink surfaces crashed (double free) after a few minutes.
Adreno 840 also crashed while rasterising the shell with QPainter, so it gets no paint device on the GPU.
No switch falls back to the configured GPU path: llvmpipe is the backend, not a fallback."""
import os
import subprocess
import sys

SOFTWARE = {'QT_QUICK_BACKEND': 'software', 'LIBGL_ALWAYS_SOFTWARE': '1', 'GALLIUM_DRIVER': 'llvmpipe'}
DROPPED = ('MESA_LOADER_DRIVER_OVERRIDE', 'QT_ENABLE_GLYPH_CACHE_WORKAROUND')
SETTING = 'SceneGraphBackend=software'


def gpu_path_crashes():
    """Prefer a blank paint device over the two known Adreno 840 crashes: the Zink surfaces and QPainter."""
    name = os.environ.get('DROIDDECK_GPU_NAME', '')
    return 'Adreno' in name and '840' in name


def main():
    command = ['/usr/bin/plasmashell', *sys.argv[1:]]
    env = dict(os.environ)
    env.update(SOFTWARE)
    for key in DROPPED:
        env.pop(key, None)
    if gpu_path_crashes():
        # The shell reads Plasma's QtQuick renderer settings from this shared QtProject.conf.
        conf = os.path.join(os.environ.get('HOME', '/root'), '.config', 'QtProject.conf')
        try:
            with open(conf, encoding='utf-8') as handle:
                configured = SETTING in handle.read()
        except OSError:
            configured = False
        if not configured:
            os.makedirs(os.path.dirname(conf), exist_ok=True)
            with open(conf, 'a', encoding='utf-8') as handle:
                handle.write(f'[QtQuickRendererSettings]\n{SETTING}\n')
    return subprocess.call(command, env=env)


if __name__ == '__main__':
    raise SystemExit(main())
