#!/usr/bin/env python3
import argparse
from concurrent.futures import ThreadPoolExecutor
import ctypes
import hashlib
import html
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import time


def command(argv, timeout=15):
    if not shutil.which(argv[0]):
        return {'status': 'missing', 'command': argv}
    process = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    started = time.monotonic()
    status = None
    while True:
        try:
            stdout, stderr = process.communicate(timeout=0.25)
            break
        except subprocess.TimeoutExpired:
            if time.monotonic() - started >= timeout:
                status = 'timeout'
            elif argv[0].startswith('glmark2') and too_hot(thermal()):
                status = 'thermal-stop'
            if status:
                process.kill()
                stdout, stderr = process.communicate()
                break
    return {'status': status or ('ok' if process.returncode == 0 else 'failed'), 'exit_code': process.returncode,
            'command': argv, 'stdout': stdout[-16000:], 'stderr': stderr[-4000:]}


def thermal():
    result = {}
    for directory in Path('/sys/class/thermal').glob('thermal_zone*'):
        try:
            kind = (directory / 'type').read_text().strip()
            if any(word in kind.lower() for word in ('skin', 'battery', 'quiet', 'soc', 'cpu', 'gpu')):
                value = int((directory / 'temp').read_text())
                if 1000 <= value <= 150000:
                    result[kind] = max(result.get(kind, 0), value / 1000)
        except (OSError, ValueError):
            pass
    return result


def too_hot(values):
    return any(value >= (45 if any(word in key.lower() for word in ('battery', 'skin', 'quiet')) else 80)
               for key, value in values.items())


def hash_worker(seconds):
    data = bytes(range(256)) * 4096
    count = 0
    started = time.monotonic()
    end = started + seconds
    check_at = started + 0.5
    stopped = False
    while time.monotonic() < end:
        hashlib.sha256(data).digest()
        count += 1
        if time.monotonic() >= check_at:
            if too_hot(thermal()):
                stopped = True
                break
            check_at = time.monotonic() + 0.5
    elapsed = time.monotonic() - started
    return {'bytes': count * len(data), 'seconds': elapsed, 'bytes_per_second': count * len(data) / elapsed,
            'thermal_stopped': stopped}


def cpu_benchmark(seconds, workers):
    single = hash_worker(seconds)
    if single['thermal_stopped'] or too_hot(thermal()):
        return {'workload': 'sha256-1MiB', 'single': single, 'multi': {'status': 'thermal-stop', 'workers': workers}}
    with ThreadPoolExecutor(max_workers=workers) as pool:
        results = list(pool.map(hash_worker, [seconds] * workers))
    multi = {'workers': workers, 'bytes_per_second': sum(r['bytes_per_second'] for r in results), 'runs': results}
    return {'workload': 'sha256-1MiB', 'single': single, 'multi': multi,
            'scope': 'Native guest Python/OpenSSL hashing, includes scheduling and PRoot overhead; not a GPU or FEX score.'}


def vulkan_devices():
    try:
        library = ctypes.CDLL('libvulkan.so.1')
        class App(ctypes.Structure):
            _fields_ = [('sType',ctypes.c_int),('pNext',ctypes.c_void_p),('name',ctypes.c_char_p),
                        ('version',ctypes.c_uint32),('engine',ctypes.c_char_p),('engineVersion',ctypes.c_uint32),('apiVersion',ctypes.c_uint32)]
        class Info(ctypes.Structure):
            _fields_ = [('sType',ctypes.c_int),('pNext',ctypes.c_void_p),('flags',ctypes.c_uint32),('app',ctypes.POINTER(App)),
                        ('layerCount',ctypes.c_uint32),('layers',ctypes.c_void_p),('extensionCount',ctypes.c_uint32),('extensions',ctypes.c_void_p)]
        app = App(0,None,b'DroidDeck diagnostic',1,None,0,1 << 22)
        info = Info(1,None,0,ctypes.pointer(app),0,None,0,None)
        instance = ctypes.c_void_p()
        library.vkCreateInstance.argtypes = [ctypes.POINTER(Info),ctypes.c_void_p,ctypes.POINTER(ctypes.c_void_p)]
        code = library.vkCreateInstance(ctypes.byref(info),None,ctypes.byref(instance))
        if code != 0:
            return {'status':'failed','vk_result':code}
        try:
            count = ctypes.c_uint32()
            library.vkEnumeratePhysicalDevices.argtypes = [ctypes.c_void_p,ctypes.POINTER(ctypes.c_uint32),ctypes.c_void_p]
            code = library.vkEnumeratePhysicalDevices(instance,ctypes.byref(count),None)
            if code != 0 or not count.value or count.value > 64:
                return {'status':'failed','vk_result':code,'count':count.value}
            devices = (ctypes.c_void_p * count.value)()
            library.vkEnumeratePhysicalDevices(instance,ctypes.byref(count),devices)
            library.vkGetPhysicalDeviceProperties.argtypes = [ctypes.c_void_p,ctypes.c_void_p]
            found = []
            for device in devices:
                buffer = ctypes.create_string_buffer(4096)
                library.vkGetPhysicalDeviceProperties(device,buffer)
                words = ctypes.cast(buffer,ctypes.POINTER(ctypes.c_uint32))
                found.append({'name':buffer.raw[20:276].split(b'\0',1)[0].decode(errors='replace'),
                              'vendor_id':hex(words[2]),'device_id':hex(words[3]),'device_type':words[4],
                              'api_version':f'{words[0] >> 22}.{(words[0] >> 12) & 1023}.{words[0] & 4095}'})
            return {'status':'ok','devices':found,'scope':'Physical device enumeration without direct-display extensions; not a rendering benchmark.'}
        finally:
            library.vkDestroyInstance.argtypes = [ctypes.c_void_p,ctypes.c_void_p]
            library.vkDestroyInstance(instance,None)
    except (OSError, AttributeError) as error:
        return {'status':'unavailable','reason':str(error)}


def install():
    path = Path.home() / '.local/share/applications/droiddeck-performance.desktop'
    path.parent.mkdir(parents=True,exist_ok=True)
    text = '[Desktop Entry]\nType=Application\nName=DroidDeck Performance\nName[zh_CN]=DroidDeck 性能测试\nComment=Bounded CPU, GPU and display diagnostics\nExec=konsole --hold -e droiddeck-performance --quick\nTerminal=false\nIcon=utilities-system-monitor\nCategories=System;Monitor;\nX-DroidDeck-Performance=1\n'
    if not path.exists() or 'X-DroidDeck-Performance=1' in path.read_text():
        path.write_text(text)


def write_report(path, report):
    path.parent.mkdir(parents=True,exist_ok=True)
    path.write_text(json.dumps(report,ensure_ascii=False,indent=2) + '\n')
    path.with_suffix('.html').write_text('<!doctype html><meta charset="utf-8"><title>DroidDeck Performance</title>'
        '<style>body{font:18px system-ui;max-width:1000px;margin:32px auto;padding:16px}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style>'
        '<h1>DroidDeck Performance</h1><p>Guest rendering throughput is not physical display refresh. '
        'Use tools/display_probe.py over USB for Android presentation timing. No driver or refresh setting was changed.</p><pre>'
        + html.escape(json.dumps(report,ensure_ascii=False,indent=2)) + '</pre>')


def main():
    parser = argparse.ArgumentParser(description='Short, repeatable native guest CPU/GPU diagnostics; no automatic package installation or setting changes.')
    parser.add_argument('--install',action='store_true')
    parser.add_argument('--quick',action='store_true')
    parser.add_argument('--cpu',action='store_true')
    parser.add_argument('--gpu',action='store_true')
    parser.add_argument('--seconds',type=int,choices=range(1,11),default=3,metavar='1..10')
    parser.add_argument('--threads',type=int,choices=range(1,9),default=min(4,os.cpu_count() or 1),metavar='1..8')
    parser.add_argument('--output',type=Path)
    args = parser.parse_args()
    if args.install:
        install()
        return 0
    try:
        os.nice(5)
    except (OSError,AttributeError):
        pass
    report = {'schema':1,'time':time.strftime('%Y-%m-%dT%H:%M:%S%z'), 'architecture':platform.machine(),
              'visible_cpus':os.cpu_count(), 'affinity':sorted(os.sched_getaffinity(0)) if hasattr(os,'sched_getaffinity') else None,
              'thermal_before_c':thermal(), 'display':command(['kscreen-doctor','-o']),
              'notes':['Wi-Fi management is not required: Android supplies network access.',
                       'GPU benchmark FPS measures guest rendering, not physical panel refresh.',
                       'No root, overclock, thermal override or global driver configuration is applied.']}
    hot = too_hot(report['thermal_before_c'])
    if hot:
        report['load_skipped'] = 'Visible sensor reached 80 C (CPU/GPU) or 45 C (battery/skin); cool down before testing.'
    if (args.cpu or args.quick) and not hot:
        report['cpu'] = cpu_benchmark(args.seconds,args.threads)
    if args.gpu or args.quick:
        report['gpu'] = {'opengl':command(['glxinfo','-B']), 'vulkan':vulkan_devices()}
        if not hot and not too_hot(thermal()):
            report['gpu']['benchmark'] = command(['glmark2-wayland','--size','800x600','--swap-mode','fifo',
                                                  '-b','build:duration=5.0'],timeout=15)
            if report['gpu']['benchmark']['status'] == 'missing':
                report['gpu']['install_hint'] = 'Optional Ubuntu package: sudo apt-get install --no-install-recommends glmark2-wayland (about 10 MB installed).'
    report['thermal_after_c'] = thermal()
    path = args.output or Path.home()/'.local/state/droiddeck/performance'/time.strftime('%Y%m%d-%H%M%S.json')
    write_report(path,report)
    print(json.dumps(report,ensure_ascii=False,indent=2))
    print(f'JSON: {path}\nHTML: {path.with_suffix(".html")}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
