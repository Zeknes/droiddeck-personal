#!/bin/bash
set -u
packages=(pyqt6-dev-tools ubuntu-drivers-common)
if dpkg-query -W -f='${db:Status-Status}\n' "${packages[@]}" 2>/dev/null | awk 'BEGIN {n=0; ok=1} {n++; if ($0 != "installed") ok=0} END {exit !(n==2 && ok)}'; then
  exit 0
fi
mkdir -p "${HOME}/.cache/droiddeck"
exec 9>"${HOME}/.cache/droiddeck/driver-manager-deps.lock"
flock -n 9 || exit 0
exec >>"${HOME}/.cache/droiddeck/driver-manager-deps.log" 2>&1
export DEBIAN_FRONTEND=noninteractive
if ! droiddeck-root /usr/bin/apt-get install -y --no-install-recommends "${packages[@]}"; then
  droiddeck-root /usr/bin/apt-get update && droiddeck-root /usr/bin/apt-get install -y --no-install-recommends "${packages[@]}"
fi
